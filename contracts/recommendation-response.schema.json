          "COVERAGE_LABELS_UNAVAILABLE",
          "INTERVAL_NOT_CALIBRATED",
          "METRIC_NOT_ESTIMATED",
          "LOW_SUPPORT",
          "LOW_OVERLAP",
          "OUT_OF_DISTRIBUTION",
          "UNSTABLE_RANKING",
          "MISSING_REQUIRED_CAPABILITY",
