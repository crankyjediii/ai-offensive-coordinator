            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranking_policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "ensemble_members": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "ranking_passed_policy": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BROAD_CANDIDATES_ONLY",
              "COVERAGE_LABELS_UNAVAILABLE",
              "INTERVAL_NOT_CALIBRATED",
              "METRIC_NOT_ESTIMATED",
              "LOW_SUPPORT",
              "LOW_OVERLAP",
              "OUT_OF_DISTRIBUTION",
              "UNSTABLE_RANKING",
              "MISSING_REQUIRED_CAPABILITY",
              "MODEL_UNAVAILABLE",
              "SNAPSHOT_UNAVAILABLE",
              "STALE_SOURCE",
              "UNKNOWN_PUBLICATION_TIME",
              "PRIOR_DOMINATED",
              "NO_ELIGIBLE_CANDIDATE"
            ]
          },
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "required": [
        "evaluation_report_id",
        "calibration_artifact_id",
        "ranking_policy_id",
        "ensemble_members",
        "ranking_passed_policy",
        "reason_codes"
      ]
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "template",
            "facts_only_language_model"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      },
      "required": [
        "engine",
        "text"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "is_synthetic_example",
    "example_notice",
    "status",
    "reason_codes",
    "mode",
    "cutoff_at",
    "snapshot_id",
    "model_bundle_id",
    "outcome_cohort_id",
    "recommended_candidate_id",
    "candidates",
    "defense_expectation",
    "data_evidence",
    "model_evidence",
    "explanation"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed recommendation response v1",
  "description": "Starter contract. Domain status is independent of HTTP transport errors. Null is unavailable, never equivalent to zero. Application checks include unique candidate IDs, consistent rank ordering, recommendation membership, snapshot/bundle compatibility, interval order, and probability normalization.",
  "allOf": [
    {
      "if": {
        "properties": {
          "is_synthetic_example": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "example_notice": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "example_notice": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "abstained",
              "unavailable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recommended_candidate_id": {
            "type": "null"
          },
          "reason_codes": {
            "minItems": 1
          },
          "model_evidence": {
            "properties": {
              "ranking_passed_policy": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "candidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "limited"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recommended_candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "candidates": {
            "minItems": 1
          },
          "model_evidence": {
            "properties": {
              "ranking_passed_policy": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "limited"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "defense_expectation": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "defense_expectation": {
            "properties": {
              "coverage_probabilities": {
                "type": "null"
              },
              "blitz_probability": {
                "type": "null"
              },
              "expected_box_count": {
                "type": "null"
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
